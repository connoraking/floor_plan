{
  "name": "easy-floor-planner",
  "version": "2.3.4",
  "description": "An offline desktop app for placing true-to-size furniture on PDF floor plans.",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Floor Planner contributors",
  "license": "MIT",
  "private": true,
  "desktopName": "floor-planner.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/connoraking/floor_plan.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:electron": "npm run build && node scripts/run-electron-smoke.cjs",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.floorplanner.easy",
    "productName": "Floor Planner",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-web/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "icon": "build-resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Floor-Planner-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Floor Planner"
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "artifactName": "Floor-Planner-${version}-${arch}.${ext}",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "artifactName": "Floor-Planner-${version}-${arch}.${ext}",
      "category": "Graphics",
      "syncDesktopName": true,
      "target": "AppImage"
    }
  }
}
